<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!-- IMPORTANT: viewport fix — prevents the wide table from shrinking the entire page.
     initial-scale=1 keeps the layout at 1:1. maximum-scale=1 stops accidental double-tap zoom.
     user-scalable=yes still allows manual pinch-zoom for accessibility. -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f172a">
<title>Order Book & Mtr Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* =========================================================
     RESET + VIEWPORT LOCK
     ========================================================= */
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    background: #eef2f7;
    color: #0f172a;
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }
  body {
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* =========================================================
     TOP NAV / TABS
     ========================================================= */
  #tabs {
    display: flex;
    background: linear-gradient(180deg, #0f172a 0%, #131f38 100%);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset, 0 4px 12px rgba(15,23,42,0.18);
    padding: 4px 4px 0 4px;
    gap: 2px;
    padding-top: calc(4px + env(safe-area-inset-top));
  }
  #tabs .tab {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 6px 12px 6px;
    color: #94a3b8;
    background: transparent;
    border: none;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    font-family: inherit;
    font-size: clamp(11px, 3.2vw, 13px);
    font-weight: 600;
    letter-spacing: 0.3px;
    user-select: none;
    position: relative;
    transition: color .15s ease, background-color .15s ease;
    min-width: 0;
  }
  #tabs .tab .ic {
    font-size: 14px;
    line-height: 1;
    opacity: 0.9;
  }
  #tabs .tab .lbl {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #tabs .tab:hover { color: #e2e8f0; }
  #tabs .tab.active {
    color: #ffffff;
    background: rgba(14,165,233,0.14);
  }
  #tabs .tab.active::after {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: #38bdf8;
    box-shadow: 0 0 12px rgba(56,189,248,0.7);
  }

  /* =========================================================
     PANELS
     ========================================================= */
  .panel { display: none; padding: 10px; max-width: 100%; }
  .panel.active { display: block; }

  /* =========================================================
     FILTER CARD
     ========================================================= */
  .filters-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
    box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 10px rgba(15,23,42,0.03);
  }
  .filters-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .filters-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .filters-title .dot {
    width: 6px; height: 6px; border-radius: 999px; background: #38bdf8;
    box-shadow: 0 0 8px rgba(56,189,248,0.6);
  }
  .filters-toggle {
    display: none;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #334155;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 8px;
    cursor: pointer;
  }
  .filters-toggle:active { background: #e2e8f0; }

  .filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .ac-wrap {
    position: relative;
    min-width: 0;
  }
  .ac-wrap::before {
    content: attr(data-label);
    position: absolute;
    top: -7px;
    left: 10px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: #ffffff;
    padding: 0 5px;
    color: #64748b;
    z-index: 2;
    pointer-events: none;
  }
  .ac-wrap input {
    width: 100%;
    padding: 10px 12px;
    font-size: 16px;
    font-family: inherit;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    border-radius: 9px;
    outline: none;
    color: #0f172a;
    transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
    min-width: 0;
  }
  .ac-wrap input::placeholder { color: #94a3b8; font-weight: 400; }
  .ac-wrap input:hover { border-color: #94a3b8; }
  .ac-wrap input:focus {
    border-color: #0ea5e9;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(14,165,233,0.15);
  }

  /* Autocomplete dropdown */
  .ac-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    max-height: 240px;
    overflow-y: auto;
    z-index: 60;
    display: none;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(15,23,42,0.18), 0 2px 6px rgba(15,23,42,0.08);
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .ac-list.show { display: block; }
  .ac-list div {
    padding: 10px 12px;
    font-size: 13px;
    cursor: pointer;
    border-bottom: 1px solid #f1f5f9;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ac-list div:last-child { border-bottom: none; }
  .ac-list div:hover, .ac-list div.hover { background: #eff6ff; color: #0369a1; }

  /* =========================================================
     TOOLBAR / BUTTONS / STATUS
     ========================================================= */
  .toolbar {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 16px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    border: 1px solid transparent;
    border-radius: 9px;
    cursor: pointer;
    color: #ffffff;
    background: #0ea5e9;
    box-shadow: 0 1px 2px rgba(15,23,42,0.08);
    transition: transform .05s ease, background-color .15s ease, box-shadow .15s ease, border-color .15s ease;
    min-height: 38px;
    white-space: nowrap;
  }
  .btn:hover { background: #0284c7; }
  .btn:active { transform: translateY(1px); }
  .btn.gray { background: #ffffff; color: #334155; border-color: #cbd5e1; }
  .btn.gray:hover { background: #f1f5f9; border-color: #94a3b8; }
  .btn.blue { background: #2563eb; }
  .btn.blue:hover { background: #1d4ed8; }
  .btn.red  { background: #dc2626; }
  .btn.red:hover { background: #b91c1c; }
  .btn.green { background: #16a34a; }
  .btn.green:hover { background: #15803d; }
  .btn.wa-btn { background: #25d366; color: #fff; }
  .btn.wa-btn:hover { background: #1ebc59; }
  .btn .ic { font-size: 13px; line-height: 1; }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 7px 12px;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 999px;
    color: #075985;
    margin-left: auto;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status::before {
    content: "";
    width: 7px; height: 7px; border-radius: 999px;
    background: #38bdf8;
    box-shadow: 0 0 6px rgba(56,189,248,0.7);
    flex: 0 0 auto;
  }
  .status.loading { background: #fef9c3; border-color: #fde68a; color: #854d0e; }
  .status.loading::before { background: #eab308; box-shadow: 0 0 6px rgba(234,179,8,0.7); animation: pulse 1s ease-in-out infinite; }
  .status.error { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
  .status.error::before { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,0.6); }
  .status.ok::before { background: #10b981; box-shadow: 0 0 6px rgba(16,185,129,0.7); }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(1.25); }
  }

  /* =========================================================
     DATA TABLE
     ========================================================= */
  .table-wrap {
    overflow: auto;
    max-height: 72vh;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 6px 14px rgba(15,23,42,0.05);
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    max-width: 100%;
  }
  .table-wrap table {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 12px;
    table-layout: auto;
    width: max-content;
    min-width: 100%;
  }
  .table-wrap th,
  .table-wrap td {
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 3px 8px;
    text-align: left;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.3;
    vertical-align: middle;
    color: #0f172a;
    max-width: 340px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .table-wrap td.wrap {
    white-space: normal;
    word-break: normal;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 340px;
    max-height: 2.7em;
    vertical-align: middle;
  }
  .table-wrap th {
    background: #0f172a;
    color: #f1f5f9;
    position: sticky;
    top: 0;
    z-index: 2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    border-right: 1px solid #1e293b;
    border-bottom: 2px solid #38bdf8;
    padding: 6px 10px;
    white-space: nowrap;
    vertical-align: middle;
    max-width: none;
    max-height: none;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
  }
  .table-wrap tbody tr:nth-child(even) td { background: #fafbfd; }
  .table-wrap tbody tr:hover td { background: #eff6ff; cursor: pointer; }
  .table-wrap tbody tr td:first-child {
    position: sticky;
    left: 0;
    z-index: 4;
    background: #ffffff;
    border-right: 2px solid #cbd5e1;
    font-weight: 600;
  }
  .table-wrap tbody tr:nth-child(even) td:first-child { background: #f1f5f9; }
  .table-wrap tbody tr:hover td:first-child { background: #dbeafe; }
  .table-wrap thead tr th:first-child {
    z-index: 6;
    left: 0;
    background: #0f172a;
    border-right: 2px solid #38bdf8;
  }
  .table-wrap tbody tr td.sticky-party {
    position: sticky;
    left: var(--col1-w, 60px);
    z-index: 3;
    background: #ffffff;
    border-right: 2px solid #cbd5e1;
    font-weight: 600;
  }
  .table-wrap tbody tr:nth-child(even) td.sticky-party { background: #f1f5f9; }
  .table-wrap tbody tr:hover td.sticky-party { background: #dbeafe; }
  .table-wrap thead tr th.sticky-party {
    z-index: 5;
    left: var(--col1-w, 60px);
    background: #0f172a;
    border-right: 2px solid #38bdf8;
  }

  /* Filter Chips */
  .chips { display: none; flex-wrap: wrap; gap: 6px; padding: 6px 2px 8px 2px; align-items: center; }
  .chips.show { display: flex; }
  .chip {
    display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; font-weight: 600;
    background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; padding: 4px 4px 4px 10px;
    border-radius: 999px; box-shadow: 0 1px 2px rgba(15,23,42,0.05); max-width: 240px; overflow: hidden;
    white-space: nowrap; text-overflow: ellipsis;
  }
  .chip .k { color: #0369a1; font-weight: 700; letter-spacing: 0.3px; text-transform: uppercase; font-size: 10px; }
  .chip button {
    display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px;
    border-radius: 999px; background: #f1f5f9; border: none; color: #475569; font-size: 15px; cursor: pointer;
  }
  .chip-clear-all {
    font-size: 11px; font-weight: 700; background: transparent; border: 1px dashed #cbd5e1;
    color: #64748b; padding: 4px 10px; border-radius: 999px; cursor: pointer;
  }
  .toast {
    position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(20px);
    background: #0f172a; color: #f1f5f9; padding: 10px 18px; border-radius: 999px; font-size: 12.5px;
    font-weight: 600; box-shadow: 0 8px 24px rgba(15,23,42,0.35); opacity: 0; pointer-events: none;
    transition: opacity .18s ease, transform .18s ease; z-index: 10000; display: flex; align-items: center; gap: 8px;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .toast::before { content: ""; width: 8px; height: 8px; border-radius: 999px; background: #10b981; }
  tr.blank-challan td.challan-col { background: #fee2e2 !important; color: #991b1b; font-weight: 600; }
  .table-wrap td a { color: #1d4ed8; text-decoration: underline; font-weight: 600; cursor: pointer; }
  .empty {
    padding: 40px 24px; text-align: center; background: #ffffff; border: 1px dashed #cbd5e1;
    font-size: 13px; color: #64748b; border-radius: 12px; line-height: 1.6;
  }
  .empty::before { content: "📊"; display: block; font-size: 28px; margin-bottom: 8px; }

  /* Modals */
  #preview {
    position: fixed; inset: 0; background: rgba(15,23,42,0.72); backdrop-filter: blur(6px);
    display: none; z-index: 9999; padding: 16px; align-items: center; justify-content: center; flex-direction: column; gap: 12px;
  }
  #preview.show { display: flex; }
  #preview .box {
    background: #ffffff; border-radius: 14px; padding: 14px; width: min(720px, 96vw);
    max-height: 80vh; display: flex; flex-direction: column; align-items: center; gap: 10px; overflow: auto;
  }
  #preview .actions { display: flex; gap: 8px; }
  #preview .actions button { padding: 10px 20px; font-weight: 600; border: none; border-radius: 9px; cursor: pointer; color: #fff; }
  #preview .actions .open { background: #2563eb; }
  #preview .actions .close { background: #dc2626; }

  #pdfChoice {
    position: fixed; inset: 0; background: rgba(15,23,42,0.72); backdrop-filter: blur(6px);
    display: none; z-index: 10001; padding: 20px; align-items: center; justify-content: center;
  }
  #pdfChoice.show { display: flex; }
  #pdfChoice .box {
    background: #ffffff; border-radius: 16px; padding: 22px 20px 18px; width: min(420px, 96vw);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35); text-align: center;
  }
  #pdfChoice .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  #pdfChoice .actions button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 12px;
    font-weight: 700; border: none; border-radius: 11px; cursor: pointer; color: #ffffff; min-height: 52px;
  }
  #pdfChoice .actions .dl { background: #2563eb; }
  #pdfChoice .actions .wa { background: #25d366; }
  #pdfChoice .cancel { background: transparent; border: 1px solid #cbd5e1; color: #334155; padding: 9px 18px; border-radius: 10px; cursor: pointer; }

  /* Settings Box */
  .setting-box {
    background: #ffffff; border: 1px solid #e2e8f0; padding: 16px; margin-bottom: 12px; border-radius: 12px;
  }
  .setting-box label {
    display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; margin-bottom: 8px; color: #0f172a;
  }
  .setting-box input[type=text] {
    width: 100%; padding: 11px 12px; font-size: 16px; border: 1px solid #cbd5e1; border-radius: 9px;
    margin-bottom: 10px; background: #f8fafc; color: #0f172a; outline: none;
  }
  .setting-box .row { display: flex; gap: 8px; align-items: center; }

  /* =========================================================
     MTR CALCULATOR TAB STYLING (ISOLATED TO #panel-calc)
     ========================================================= */
  #panel-calc .calc-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  #panel-calc .calc-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 14px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 4px 12px rgba(15,23,42,0.03);
  }
  #panel-calc .calc-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  #panel-calc textarea {
    width: 100%;
    height: 90px;
    padding: 12px;
    font-family: inherit;
    font-size: 14px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #f8fafc;
    color: #0f172a;
    outline: none;
    resize: vertical;
    line-height: 1.5;
  }
  #panel-calc textarea:focus {
    border-color: #0ea5e9;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(14,165,233,0.15);
  }
  #panel-calc .calc-ctrls {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  #panel-calc .multiplier-input {
    width: 120px;
    padding: 9px 10px;
    font-size: 15px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #f8fafc;
    font-weight: 600;
    color: #0f172a;
  }
  #panel-calc .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
    margin-bottom: 12px;
  }
  #panel-calc .stat-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: left;
  }
  #panel-calc .stat-box .lbl {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  #panel-calc .stat-box .val {
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2px;
  }
  #panel-calc .stat-box.highlight .val {
    color: #0284c7;
  }
  #calcTable {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
  }
  #calcTable th, #calcTable td {
    padding: 8px 12px;
    border: 1px solid #e2e8f0;
    font-size: 13px;
    text-align: right;
  }
  #calcTable th:first-child, #calcTable td:first-child { text-align: left; font-weight: 600; }
  #calcTable th {
    background: #0f172a;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  #calcTable tr:nth-child(even) td { background: #fafbfd; }
  #calcTable tr.total-row td {
    background: #f1f5f9;
    font-weight: 700;
    font-size: 13.5px;
    border-top: 2px solid #0f172a;
  }
  #calcTable input.row-mtr-input {
    width: 75px;
    padding: 4px 6px;
    font-size: 13px;
    text-align: right;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    font-weight: 600;
  }

  /* =========================================================
     PURE EXCEL-STYLE PRINT VIEW (Calculations)
     ========================================================= */
  @media print {
    body * { visibility: hidden !important; }
    #panel-calc, #panel-calc #printArea, #panel-calc #printArea * {
      visibility: visible !important;
    }
    #panel-calc {
      display: block !important;
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 10px !important;
      background: #ffffff !important;
    }
    #panel-calc .no-print { display: none !important; }
    #calcTable {
      border: 1.5pt solid #000 !important;
      border-collapse: collapse !important;
      width: 100% !important;
    }
    #calcTable th, #calcTable td {
      border: 1pt solid #000 !important;
      color: #000 !important;
      background: #fff !important;
      padding: 6px 8px !important;
      font-size: 11pt !important;
    }
    #calcTable th {
      font-weight: bold !important;
      background: #f2f2f2 !important;
    }
    #calcTable tr.total-row td {
      border-top: 2pt solid #000 !important;
      border-bottom: 2pt solid #000 !important;
