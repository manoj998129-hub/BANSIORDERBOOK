<script>
/* =========================================================================
   EXISTING APP LOGIC (PRESERVED 100%)
   ========================================================================= */
const state = {
  data: { headers: [], rows: [] },
  pages: { all: 1, nochallan: 1 },
  orderGroups: [],
  previewUrl: null,
  linkColumns: { order: -1, ds: -1 },
  cols: { party:-1, order:-1, challan:-1, design:-1, material:-1, job:-1, ds:-1 }
};

/* Tab Switching */
document.querySelectorAll('#tabs .tab').forEach(t => {
  t.addEventListener('click', () => {
    document.querySelectorAll('#tabs .tab').forEach(x => { x.classList.remove('active'); x.setAttribute('aria-selected','false'); });
    document.querySelectorAll('.panel').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    t.setAttribute('aria-selected','true');
    document.getElementById('panel-' + t.dataset.tab).classList.add('active');
  });
});

/* Filters Toggle */
document.querySelectorAll('.filters-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const target = document.getElementById(btn.dataset.target);
    if (!target) return;
    const collapsed = target.classList.toggle('collapsed');
    btn.textContent = collapsed ? 'Show' : 'Hide';
  });
});

function loadSettings() {
  document.getElementById('dataUrl').value   = localStorage.getItem('dataUrl')   || '';
  document.getElementById('uploadUrl').value = localStorage.getItem('uploadUrl') || '';
}
function saveDataUrl() {
  const v = document.getElementById('dataUrl').value.trim();
  localStorage.setItem('dataUrl', v);
  document.getElementById('dataMsg').textContent = 'Saved ✓';
  fetchData();
}
function clearDataUrl() {
  localStorage.removeItem('dataUrl');
  document.getElementById('dataUrl').value = '';
  document.getElementById('dataMsg').textContent = 'Cleared';
  state.data = { headers: [], rows: [] };
  state.orderGroups = [];
  renderAll();
}
function saveUploadUrl() {
  const v = document.getElementById('uploadUrl').value.trim();
  localStorage.setItem('uploadUrl', v);
  document.getElementById('uploadMsg').textContent = 'Saved ✓';
}
function clearUploadUrl() {
  localStorage.removeItem('uploadUrl');
  document.getElementById('uploadUrl').value = '';
  document.getElementById('uploadMsg').textContent = 'Cleared';
}

async function fetchData() {
  const url = localStorage.getItem('dataUrl');
  if (!url) { renderAll(); return; }
  setStatus('all', 'Loading…', 'loading');
  setStatus('nochallan', 'Loading…', 'loading');
  try {
    const res = await fetch(url);
    const text = await res.text();
    if (!text.trim().startsWith('{') && !text.trim().startsWith('[')) {
      setStatus('all', 'Not JSON. Starts: ' + text.slice(0, 100), 'error');
      setStatus('nochallan', 'Not JSON.', 'error');
      return;
    }
    const json = JSON.parse(text);
    if (Array.isArray(json)) {
      state.data.headers = json[0] || [];
      state.data.rows = json.slice(1).map(r => ({ values: r, links: [], bgs: [], fgs: [], bolds: [] }));
    } else {
      state.data.headers = json.headers || [];
      state.data.rows = (json.rows || []).map(r => ({
        values: r.values || r,
        links:  r.links  || [],
        bgs:    r.bgs    || [],
        fgs:    r.fgs    || [],
        bolds:  r.bolds  || []
      }));
    }
    setStatus('all', 'Loaded ' + state.data.rows.length + ' rows', 'ok');
    setStatus('nochallan', 'Loaded ' + state.data.rows.length + ' rows', 'ok');
    detectColumns();
    buildOrderGroups();
    buildAutocomplete();
    renderAll();
  } catch (e) {
    setStatus('all', 'Error: ' + e.message, 'error');
    setStatus('nochallan', 'Error: ' + e.message, 'error');
  }
}
function setStatus(tab, txt, kind) {
  const el = document.getElementById('status-' + tab);
  if (!el) return;
  el.textContent = txt;
  el.classList.remove('loading', 'error', 'ok');
  if (kind) el.classList.add(kind);
}

function detectColumns() {
  const hs = state.data.headers.map(h => (h || '').toString().toLowerCase().trim());
  state.cols.party = hs.findIndex(h => h.indexOf('party') >= 0);
  state.cols.order = hs.findIndex(h => h.indexOf('order') === 0 || h.indexOf('order no') >= 0);
  state.cols.challan = hs.findIndex(h => {
    const n = h.replace(/\s+/g, '');
    return n.indexOf('challan') >= 0 || n.indexOf('chall') >= 0;
  });
  state.cols.design = hs.findIndex(h => {
    const n = h.replace(/\s+/g, '');
    return n === 'ds' || n === 'dsno' || n.indexOf('dsno') === 0 ||
           n.indexOf('designno') >= 0 || n.indexOf('design') === 0;
  });
  state.cols.material = hs.findIndex(h => {
    const n = h.replace(/\s+/g, '').toLowerCase();
    return n.indexOf('material') >= 0 || n.indexOf('matrial') >= 0 || n.indexOf('metrial') >= 0;
  });
  state.cols.job = hs.findIndex(h => h.replace(/\s+/g, '').indexOf('job') >= 0);
  state.linkColumns.order = state.cols.order;
  state.linkColumns.ds    = state.cols.design;
}

function isLinkColumn(i) {
  return i === state.linkColumns.order || i === state.linkColumns.ds;
}
function colIndex(key) {
  return state.cols[key] != null ? state.cols[key] : -1;
}

function buildOrderGroups() {
  const oi = colIndex('order');
  if (oi < 0) { state.orderGroups = []; return; }
  const groups = [];
  let lastMain = '';
  state.data.rows.forEach(r => {
    const v = (r.values[oi] || '').toString().trim();
    if (!v) { r._mainOrder = lastMain; return; }
    const isSub = /^\d{1,2}$/.test(v) && lastMain !== '';
    if (!isSub) {
      lastMain = v;
      if (!groups.includes(v)) groups.push(v);
    }
    r._mainOrder = lastMain;
  });
  groups.sort((a, b) => {
    const na = parseFloat(a), nb = parseFloat(b);
    if (!isNaN(na) && !isNaN(nb)) return na - nb;
    return a.localeCompare(b);
  });
  state.orderGroups = groups;
}

const autoData = { party: [], order: [], challan: [], design: [], material: [], job: [] };
function buildAutocomplete() {
  for (const key in autoData) {
    const idx = colIndex(key);
    if (idx < 0) { autoData[key] = []; continue; }
    const set = new Set();
    state.data.rows.forEach(r => {
      const v = (r.values[idx] || '').toString().trim();
      if (v) set.add(v);
    });
    autoData[key] = Array.from(set).sort((a,b) => {
      const na = parseFloat(a), nb = parseFloat(b);
      if (!isNaN(na) && !isNaN(nb)) return na - nb;
      return a.localeCompare(b);
    });
  }
  autoData.order = state.orderGroups.slice();
}

function attachAutocomplete(input) {
  const wrap = input.parentElement;
  const list = document.createElement('div');
  list.className = 'ac-list';
  wrap.appendChild(list);

  function close() { list.classList.remove('show'); list.innerHTML = ''; }
  function lastFragment() {
    const parts = input.value.split(',');
    return parts[parts.length - 1].trim().toLowerCase();
  }
  function prefixBeforeLastComma() {
    const idx = input.value.lastIndexOf(',');
    if (idx < 0) return '';
    return input.value.slice(0, idx + 1).trim() + ' ';
  }

  function open(matches) {
    if (!matches.length) { close(); return; }
    list.innerHTML = matches.slice(0, 80).map(m => '<div>' + escapeHtml(m) + '</div>').join('');
    list.classList.add('show');
    list.querySelectorAll('div').forEach(d => {
      d.addEventListener('mousedown', e => {
        e.preventDefault();
        const chosen = d.textContent;
        const key = input.dataset.col;
        if (key === 'order' || key === 'challan' || key === 'design') {
          input.value = prefixBeforeLastComma() + chosen;
        } else {
          input.value = chosen;
        }
        close();
        const tab = input.id.startsWith('f2') ? 'nochallan' : 'all';
        state.pages[tab] = 1;
        renderAll();
      });
    });
  }

  input.addEventListener('input', () => {
    const key = input.dataset.col;
    const q = lastFragment();
    const tab = input.id.startsWith('f2') ? 'nochallan' : 'all';
    state.pages[tab] = 1;
    renderAll();
    if (!q) { open(autoData[key] || []); return; }
    open((autoData[key] || []).filter(v => v.toLowerCase().includes(q)));
  });
  input.addEventListener('focus', () => {
    const key = input.dataset.col;
    const q = lastFragment();
    const pool = autoData[key] || [];
    if (!q) open(pool);
    else open(pool.filter(v => v.toLowerCase().includes(q)));
  });
  input.addEventListener('blur', () => setTimeout(close, 150));
}
document.querySelectorAll('.ac-wrap input').forEach(attachAutocomplete);

function norm(s) { return (s == null ? '' : s.toString()).toLowerCase().trim(); }
function parseMulti(v) { return norm(v).split(',').map(s => s.trim()).filter(s => s.length > 0); }

function getFiltered(tab) {
  const prefix = tab === 'all' ? 'f-' : 'f2-';
  const fMulti = {
    order:   parseMulti(document.getElementById(prefix + 'order').value),
    challan: parseMulti(document.getElementById(prefix + 'challan').value),
    design:  parseMulti(document.getElementById(prefix + 'design').value)
  };
  const fSingle = {
    party:    norm(document.getElementById(prefix + 'party').value),
    material: norm(document.getElementById(prefix + 'material').value),
    job:      norm(document.getElementById(prefix + 'job').value)
  };

  const ci = state.cols;
  let rows = state.data.rows;

  if (tab === 'nochallan' && ci.challan >= 0) {
    rows = rows.filter(r => !r.values[ci.challan] || r.values[ci.challan].toString().trim() === '');
  }
  if (fMulti.order.length && ci.order >= 0) {
    const matched = [];
    let currentMain = '';
    state.data.rows.forEach(r => {
      const raw = (r.values[ci.order] || '').toString().trim();
      const isSubNumber = /^\d{1,2}$/.test(raw);
      if (raw && (!currentMain || !isSubNumber)) currentMain = raw.toLowerCase();
      const hit = fMulti.order.some(q => currentMain.includes(q));
      if (hit) matched.push(r);
    });
    rows = matched;
  }
  if (fMulti.challan.length && ci.challan >= 0) {
    rows = rows.filter(r => {
      const cell = norm(r.values[ci.challan]);
      if (!cell) return false;
      return fMulti.challan.some(q => cell.includes(q));
    });
  }
  if (fMulti.design.length && ci.design >= 0) {
    rows = rows.filter(r => {
      const cell = norm(r.values[ci.design]);
      if (!cell) return false;
      return fMulti.design.some(q => cell.includes(q));
    });
  }

  const match = (r, idx, val) => {
    if (idx < 0 || !val) return true;
    return norm(r.values[idx]).includes(val);
  };
  return rows.filter(r =>
    match(r, ci.party, fSingle.party) &&
    match(r, ci.material, fSingle.material) &&
    match(r, ci.job, fSingle.job)
  );
}

function clearFilters(tab) {
  const prefix = tab === 'all' ? 'f-' : 'f2-';
  ['party','order','challan','design','material','job'].forEach(k => {
    document.getElementById(prefix + k).value = '';
  });
  state.pages[tab] = 1;
  renderAll();
}

function renderAll() { renderTab('all'); renderTab('nochallan'); }

function hasActiveFilter(tab) {
  const prefix = tab === 'all' ? 'f-' : 'f2-';
  return ['party','order','challan','design','material','job'].some(k => {
    const el = document.getElementById(prefix + k);
    return el && el.value.trim() !== '';
  });
}

function renderChips(tab) {
  const container = document.getElementById('chips-' + tab);
  if (!container) return;
  const prefix = tab === 'all' ? 'f-' : 'f2-';
  const filterDefs = [
    { key: 'party',    label: 'Party',    multi: false },
    { key: 'order',    label: 'Order',    multi: true  },
    { key: 'challan',  label: 'Challan',  multi: true  },
    { key: 'design',   label: 'DS',       multi: true  },
    { key: 'material', label: 'Material', multi: false },
    { key: 'job',      label: 'Job',      multi: false }
  ];
  const chips = [];
  filterDefs.forEach(f => {
    const el = document.getElementById(prefix + f.key);
    if (!el) return;
    const raw = el.value.trim();
    if (!raw) return;
    if (f.multi) {
      raw.split(',').map(s => s.trim()).filter(Boolean).forEach(part => {
        chips.push({ key: f.key, label: f.label, value: part, multi: true });
      });
    } else {
      chips.push({ key: f.key, label: f.label, value: raw, multi: false });
    }
  });
  if (chips.length === 0) {
    container.classList.remove('show');
    container.innerHTML = '';
    return;
  }
  container.classList.add('show');
  container.innerHTML = chips.map(c =>
    '<span class="chip" data-key="' + c.key + '" data-value="' + escapeAttr(c.value) + '" data-multi="' + (c.multi ? '1' : '0') + '">' +
    '<span class="k">' + c.label + '</span> <span class="v">' + escapeHtml(c.value) + '</span>' +
    '<button type="button" aria-label="Remove ' + c.label + ' filter">×</button>' +
    '</span>'
  ).join('') + '<button type="button" class="chip-clear-all">Clear All</button>';

  container.querySelectorAll('.chip').forEach(chip => {
    chip.querySelector('button').addEventListener('click', () => {
      removeChipFilter(tab, chip.dataset.key, chip.dataset.value, chip.dataset.multi === '1');
    });
  });
  container.querySelector('.chip-clear-all').addEventListener('click', () => clearFilters(tab));
}

function removeChipFilter(tab, key, value, isMulti) {
  const prefix = tab === 'all' ? 'f-' : 'f2-';
  const input = document.getElementById(prefix + key);
  if (!input) return;
  if (isMulti) {
    const parts = input.value.split(',').map(s => s.trim()).filter(Boolean);
    input.value = parts.filter(p => p !== value).join(', ');
  } else {
    input.value = '';
  }
  state.pages[tab] = 1;
  renderAll();
}

function renderTab(tab) {
  const wrap = document.getElementById('wrap-' + tab);
  renderChips(tab);
  if (!state.data.headers.length) {
    wrap.innerHTML = '<div class="empty">' +
      (tab === 'nochallan' ? 'Rows with empty Challan Number will appear here.' : 'Add Data Endpoint URL in Settings to load orders.') +
      '</div>';
    return;
  }
  const rows = getFiltered(tab);
  const challanIdx = state.cols.challan;
  const partyIdx = state.cols.party;
  const orderIdx = state.cols.order;
  const activeFilter = hasActiveFilter(tab);

  const isLongText = (v) => {
    const s = (v || '').toString();
    if (s.length < 42) return false;
    return s.split(/\s+/).filter(Boolean).length >= 3;
  };
  const subOrderDisplay = (raw, main) => {
    const s = (raw == null ? '' : raw.toString()).trim();
    if (!activeFilter || !s) return s;
    const isSub = /^\d{1,2}$/.test(s);
    if (!isSub || !main || main === s) return s;
    return s + '/' + main;
  };

  let html = '<table><thead><tr>';
  state.data.headers.forEach((h, i) => {
    const stickyCls = (i === partyIdx && partyIdx !== 0) ? ' class="sticky-party"' : '';
    html += '<th' + stickyCls + '>' + escapeHtml(h || '') + '</th>';
  });
  html += '</tr></thead><tbody>';
  rows.forEach(r => {
    html += '<tr>';
    state.data.headers.forEach((_, i) => {
      let val = r.values[i] != null ? r.values[i] : '';
      let displayVal = val;
      if (i === orderIdx) displayVal = subOrderDisplay(val, r._mainOrder);
      const isBlankChallan = (i === challanIdx && (!val || val.toString().trim() === ''));
      const isParty = (i === partyIdx && partyIdx !== 0);
      const doWrap = isLongText(displayVal);
      let classes = [];
      if (isBlankChallan) classes.push('challan-col');
      if (isParty) classes.push('sticky-party');
      if (doWrap && !isParty) classes.push('wrap');
      const cls = classes.length ? ' class="' + classes.join(' ') + '"' : '';

      const rawLink = r.links && r.links[i] ? r.links[i] : null;
      const link = (isLinkColumn(i) && rawLink) ? rawLink : null;
      const bg   = (r.bgs   && r.bgs[i])   ? r.bgs[i]   : '';
      const fg   = (r.fgs   && r.fgs[i])   ? r.fgs[i]   : '';
      const bold = (r.bolds && r.bolds[i]) ? true       : false;

      let style = '';
      if (bg && !isBlankChallan) style += 'background:' + bg + ';';
      if (fg) style += 'color:' + fg + ';';
      if (bold) style += 'font-weight:700;';
      const styleAttr = style ? ' style="' + style + '"' : '';
      const titleAttr = ' title="' + escapeAttr(displayVal.toString()) + '"';

      let cellContent;
      if (link) {
        cellContent = '<a href="' + escapeAttr(link) + '" data-link="' + escapeAttr(link) + '" data-text="' + escapeAttr(displayVal.toString()) + '" onclick="return handleLinkClick(event, this)">' + escapeHtml(displayVal.toString()) + '</a>';
      } else {
        cellContent = escapeHtml(displayVal.toString());
      }
      html += '<td' + cls + styleAttr + titleAttr + '>' + cellContent + '</td>';
    });
    html += '</tr>';
  });
  html += '</tbody></table>';
  wrap.innerHTML = html;

  const applyStickyOffset = () => {
    const firstCell = wrap.querySelector('tbody tr td:first-child') || wrap.querySelector('thead tr th:first-child');
    if (!firstCell) return;
    const w = Math.ceil(firstCell.getBoundingClientRect().width);
    if (w > 0) wrap.style.setProperty('--col1-w', w + 'px');
  };
  requestAnimationFrame(applyStickyOffset);
}

function copyRow(row) {
  const c = state.cols;
  const noteIdx = state.data.headers.findIndex(h => /note|detail|desc|descr|remark/i.test((h || '').toString()));
  const parts = [];
  const push = (label, i) => {
    if (i < 0) return;
    const v = (row.values[i] != null ? row.values[i] : '').toString().trim();
    if (v) parts.push(label + ': ' + v);
  };
  push('Order', c.order);
  push('DS', c.design);
  push('Party', c.party);
  push('Challan', c.challan);
  if (noteIdx >= 0 && noteIdx !== c.order && noteIdx !== c.design) push('Note', noteIdx);
  const text = parts.join(' | ');
  if (!text) return;

  const showToast = (msg) => {
    const t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._h);
    t._h = setTimeout(() => t.classList.remove('show'), 1600);
  };

  navigator.clipboard.writeText(text).then(() => showToast('Copied row'), () => showToast('Copy failed'));
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
}
function escapeAttr(s) {
  return String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

function handleLinkClick(e, el) {
  e.preventDefault();
  showPreview(el.getAttribute('data-link'), el.getAttribute('data-text'));
  return false;
}
function showPreview(url, title) {
  state.previewUrl = url;
  document.getElementById('previewTitle').textContent = title || 'Preview';
  const content = document.getElementById('previewContent');
  content.innerHTML = '';
  let fileId = null;
  let m = url.match(/\/file\/d\/([^\/]+)/) || url.match(/[?&]id=([^&]+)/);
  if (m) fileId = m[1];
  if (fileId) {
    content.innerHTML = '<iframe src="https://drive.google.com/file/d/' + fileId + '/preview" width="500" height="500" style="border:1px solid #cbd5e1;background:#fff;"></iframe>';
  } else {
    content.innerHTML = '<img src="' + url + '" alt="preview">';
  }
  document.getElementById('preview').classList.add('show');
}
function closePreview() {
  document.getElementById('preview').classList.remove('show');
  state.previewUrl = null;
}
function openFullLink() {
  if (state.previewUrl) window.open(state.previewUrl, '_blank', 'noopener');
}

function downloadPDF(tab) {
  const rows = getFiltered(tab);
  if (!rows.length) { alert('No rows to export'); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
  const pageW = doc.internal.pageSize.getWidth();
  doc.text(tab === 'nochallan' ? 'ORDER BOOK — NO CHALLAN' : 'ORDER BOOK — ALL ORDERS', 20, 20);
  const body = rows.map(r => r.values.map(v => v == null ? '' : v.toString()));
  doc.autoTable({ head: [state.data.headers], body: body, startY: 40 });
  openPdfChoice(doc.output('blob'), tab + '.pdf');
}
function openPdfChoice(blob, filename) {
  const modal = document.getElementById('pdfChoice');
  modal._blob = blob;
  modal._filename = filename;
  modal.classList.add('show');
}
function closePdfChoice() {
  document.getElementById('pdfChoice').classList.remove('show');
}
function pdfDownload() {
  const modal = document.getElementById('pdfChoice');
  const url = URL.createObjectURL(modal._blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = modal._filename;
  a.click();
  closePdfChoice();
}
async function pdfShare() {
  const modal = document.getElementById('pdfChoice');
  const file = new File([modal._blob], modal._filename, { type: 'application/pdf' });
  if (navigator.canShare && navigator.canShare({ files: [file] })) {
    await navigator.share({ files: [file], title: modal._filename });
  } else {
    pdfDownload();
  }
  closePdfChoice();
}

/* =========================================================================
   MTR CALCULATOR TAB LOGIC (ISOLATED)
   ========================================================================= */
let calcReportData = [];

function runCalculation() {
  const rawText = document.getElementById('calcInput').value;
  const globalMtr = parseFloat(document.getElementById('calcGlobalMtr').value) || 0;
  
  // Split tokens by hyphen, space, comma, semicolon or newline
  const tokens = rawText
    .split(/[\s,;\-]+/)
    .map(s => s.trim())
    .filter(s => s.length > 0);

  if (tokens.length === 0) {
    document.getElementById('calcTbody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:#991b1b; padding:20px;">No numbers detected. Please paste item numbers.</td></tr>';
    document.getElementById('calcTfoot').innerHTML = '';
    return;
  }

  // Count occurrences (preserve first-seen order)
  const map = new Map();
  tokens.forEach(tok => {
    map.set(tok, (map.get(tok) || 0) + 1);
  });

  calcReportData = [];
  map.forEach((colourCount, itemNum) => {
    calcReportData.push({
      itemNum: itemNum,
      colour: colourCount,
      mtr: globalMtr,
      totalMtr: colourCount * globalMtr
    });
  });

  renderCalcTable();
}

function renderCalcTable() {
  const tbody = document.getElementById('calcTbody');
  const tfoot = document.getElementById('calcTfoot');
  tbody.innerHTML = '';
  tfoot.innerHTML = '';

  let totalColours = 0;
  let grandTotalMtr = 0;

  calcReportData.forEach((row, index) => {
    totalColours += row.colour;
    grandTotalMtr += row.totalMtr;

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="text-align:center;">${index + 1}</td>
      <td><strong>${escapeHtml(row.itemNum)}</strong></td>
      <td style="text-align:right;">${row.colour}</td>
      <td style="text-align:right;">
        <input type="number" step="any" class="row-mtr-input" value="${row.mtr}" onchange="updateRowMtr(${index}, this.value)">
      </td>
      <td style="text-align:right; color:#64748b;">${row.colour} &times; ${row.mtr}</td>
      <td style="text-align:right; font-weight:700;">${row.totalMtr.toLocaleString('en-IN', { maximumFractionDigits: 2 })}</td>
    `;
    tbody.appendChild(tr);
  });

  // Excel summary total row
  tfoot.innerHTML = `
    <tr class="total-row">
      <td colspan="2" style="text-align:right;">TOTAL:</td>
      <td style="text-align:right;">${totalColours}</td>
      <td style="text-align:right;">-</td>
      <td style="text-align:right;">-</td>
      <td style="text-align:right; font-weight:800;">${grandTotalMtr.toLocaleString('en-IN', { maximumFractionDigits: 2 })}</td>
    </tr>
  `;

  // Update Stats Cards
  const totalScanned = calcReportData.reduce((acc, r) => acc + r.colour, 0);
  document.getElementById('statScanned').textContent = totalScanned;
  document.getElementById('statUnique').textContent = calcReportData.length;
  document.getElementById('statColours').textContent = totalColours;
  document.getElementById('statTotalMtr').textContent = grandTotalMtr.toLocaleString('en-IN', { maximumFractionDigits: 2 });
  document.getElementById('calcPrintDate').textContent = new Date().toLocaleDateString();
}

function updateRowMtr(index, val) {
  const num = parseFloat(val) || 0;
  calcReportData[index].mtr = num;
  calcReportData[index].totalMtr = calcReportData[index].colour * num;
  renderCalcTable();
}

function clearCalc() {
  document.getElementById('calcInput').value = '';
  document.getElementById('calcTbody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:#64748b; padding:24px;">Paste item numbers above and tap Calculate.</td></tr>';
  document.getElementById('calcTfoot').innerHTML = '';
  document.getElementById('statScanned').textContent = '0';
  document.getElementById('statUnique').textContent = '0';
  document.getElementById('statColours').textContent = '0';
  document.getElementById('statTotalMtr').textContent = '0';
}

function sendToWhatsApp() {
  if (!calcReportData.length) {
    alert('Please calculate first before sending to WhatsApp.');
    return;
  }
  let text = `*--- FABRIC REPORT ---*\n`;
  text += `*Date:* ${new Date().toLocaleDateString()}\n\n`;
  text += `*ITEM NO* | *COLOUR* | *MTR* | *TOTAL*\n`;
  text += `------------------------------------\n`;
  let totalColours = 0;
  let grandTotalMtr = 0;

  calcReportData.forEach(r => {
    totalColours += r.colour;
    grandTotalMtr += r.totalMtr;
    text += `${r.itemNum} : ${r.colour} col x ${r.mtr}m = *${r.totalMtr}m*\n`;
  });

  text += `------------------------------------\n`;
  text += `*TOTAL COLOURS:* ${totalColours}\n`;
  text += `*TOTAL MTR:* ${grandTotalMtr.toLocaleString('en-IN')} MTR`;

  const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
  window.open(waUrl, '_blank');
}

/* Run initial state */
loadSettings();
fetchData();
runCalculation();
</script>
